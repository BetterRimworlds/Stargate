<?xml version="1.0" encoding="utf-8" ?>
<!-- ==== Stargate/Defs/ResearchProjectDefs/ResearchProjects.xml ==== -->
<Defs>
    <ResearchProjectDef>
        <defName>BRW_QuantumStorage</defName>
        <label>Quantum Storage</label>
        <description>Deep field quantum tech that will allow the storage of, well, anything, indefinitely, in a quantum pocket dimension, provided you have enough power.

Also, gives you the power to dematerialize Pawns and Items from across the map.

This tech enables the Dematerializer tech, if you have that mod.</description>
        <baseCost>7000</baseCost>
        <techLevel>Spacer</techLevel>
        <researchViewX>0</researchViewX>
        <researchViewY>1</researchViewY>
        <requiredResearchFacilities>
            <li>MultiAnalyzer</li>
        </requiredResearchFacilities>
        <prerequisites>
            <li>LongRangeMineralScanner</li>
            <li>ShipBasics</li>
        </prerequisites>
        <tab>Stargate</tab>
    </ResearchProjectDef>
    <ResearchProjectDef>
        <defName>BRW_QuantumTeleportation</defName>
        <label>Quantum Teleportation</label>
        <description>"Beam me up, Scotty!"

This tech enables the Archotech Teleporter tech, if you have that mod.</description>
        <baseCost>6000</baseCost>
        <techLevel>Spacer</techLevel>
        <researchViewX>0</researchViewX>
        <researchViewY>3</researchViewY>
        <requiredResearchFacilities>
            <li>MultiAnalyzer</li>
        </requiredResearchFacilities>
        <prerequisites>
            <li>AdvancedFabrication</li>
            <li>ShipBasics</li>
        </prerequisites>
        <tab>Stargate</tab>
    </ResearchProjectDef>
    <ResearchProjectDef>
        <defName>Building_Stargate_research</defName>
        <label>Stargate Astro Navigation</label>
        <description>By studying the symbols on the device you have discovered and cross-referencing with stellar constellations you have found out how to activate it and travel to other locations.</description>
        <baseCost>10000</baseCost>
        <techLevel>Spacer</techLevel>
        <researchViewX>1</researchViewX>
        <researchViewY>2</researchViewY>
        <requiredResearchFacilities>
            <li>MultiAnalyzer</li>
        </requiredResearchFacilities>
        <prerequisites>
            <li>AdvancedFabrication</li>
            <li>LongRangeMineralScanner</li>
            <li>ShipBasics</li>
            <li>BRW_QuantumTeleportation</li>
            <li>BRW_QuantumStorage</li>
        </prerequisites>
        <tab>Stargate</tab>
    </ResearchProjectDef>
    <ResearchProjectDef>
        <defName>AtlantisRising</defName>
        <label>Atlantis Rising</label>
        <description>Recover the first traces of an ancient off-world facility and unlock the path to the deeper Atlantis infrastructure.</description>
        <baseCost>2222</baseCost>
        <techLevel>Spacer</techLevel>
        <researchViewX>5</researchViewX>
        <researchViewY>3</researchViewY>
        <modExtensions>
            <li Class="BetterRimworlds.Stargate.RequiresOceanBase" />
        </modExtensions>
        <tab>Stargate</tab>
    </ResearchProjectDef>
    <ResearchProjectDef>
        <defName>HiddenLab</defName>
        <label>Hidden Lab</label>
        <description>Expose a concealed laboratory hidden beneath the surface and restore its research capacity.</description>
        <baseCost>3</baseCost>
        <techLevel>Spacer</techLevel>
        <researchViewX>6</researchViewX>
        <researchViewY>1</researchViewY>
        <modExtensions>
            <li Class="BetterRimworlds.Stargate.RequiresOceanBase" />
        </modExtensions>
        <prerequisites>
            <li>AtlantisRising</li>
        </prerequisites>
        <tab>Stargate</tab>
    </ResearchProjectDef>
    <ResearchProjectDef>
        <defName>ZPMRoom</defName>
        <label>ZPM Room</label>
        <description>Unlock a dedicated Zero Point Module chamber capable of housing advanced power systems.</description>
        <baseCost>5000</baseCost>
        <techLevel>Spacer</techLevel>
        <researchViewX>6</researchViewX>
        <researchViewY>3</researchViewY>
        <requiredResearchFacilities>
            <li>MultiAnalyzer</li>
        </requiredResearchFacilities>
        <modExtensions>
            <li Class="BetterRimworlds.Stargate.RequiresOceanBase" />
        </modExtensions>
        <prerequisites>
            <li>AtlantisRising</li>
            <li>HiddenLab</li>
        </prerequisites>
        <tab>Stargate</tab>
    </ResearchProjectDef>
    <ResearchProjectDef>
        <defName>StarDriveCore</defName>
        <label>Star Drive Core</label>
        <description>Master the heart of an interstellar drive core and prepare the facility for deep-space propulsion.</description>
        <baseCost>10000</baseCost>
        <techLevel>Spacer</techLevel>
        <researchViewX>6</researchViewX>
        <researchViewY>5</researchViewY>
        <requiredResearchFacilities>
            <li>MultiAnalyzer</li>
        </requiredResearchFacilities>
        <modExtensions>
            <li Class="BetterRimworlds.Stargate.RequiresOceanBase" />
        </modExtensions>
        <prerequisites>
            <li>AtlantisRising</li>
            <li>ZPMRoom</li>
        </prerequisites>
        <tab>Stargate</tab>
    </ResearchProjectDef>
</Defs>
